{
  "$schema": "https://typedoc.org/schema.json",
  "plugin": ["typedoc-plugin-markdown"],
  "entryPoints": ["./src"],
  "entryPointStrategy": "expand",
  "exclude": ["**/index.ts"],
  "out": "./docs/api",
  "readme": "none",
  "name": "Facile JS",
  "excludeExternals": true,
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "entryFileName": "index",
  "excludeTags": ["@override", "@virtual", "@privateRemarks", "@satisfies", "@overload", "@inline", "@inlineType"]
}
