{
  "name": "@side-xp/facile",
  "version": "1.0.0",
  "description": "Lightweight JavaScript & Node utilities. ",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "js",
    "stdlib",
    "util",
    "helper",
    "easy",
    "simple"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "jsdelivr": "./dist/index.iife.js",
  "unpkg": "./dist/index.iife.js",
  "homepage": "https://github.com/side-xp/node-facile#readme",
  "bugs": {
    "url": "https://github.com/side-xp/node-facile/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/side-xp/node-facile.git"
  },
  "license": "MIT",
  "author": "Hubert GROSSIN",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepare": "husky",
    "publint": "publint",
    "attw": "attw --pack .",
    "docs:api": "typedoc && node scripts/docs.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run docs:api && npm run docs:dev",
    "docs:preview": "npm run docs:build && vitepress preview docs"
  },
  "lint-staged": {
    "**/*.{js,ts,jsx,tsx,json,jsonc}": [
      "biome check --write"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.12",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@side-xp/biome-config": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "publint": "^0.3.18",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.21.8",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.4"
  }
}
